# Expo app
EXPO_PUBLIC_API_URL=http://localhost:3001/api

# Backend
DATABASE_URL=postgresql://user:password@localhost:5432/plastic_order_manager
SESSION_SECRET=replace-with-at-least-32-random-characters
PORT=3001
NODE_ENV=development

# Comma-separated browser origins. Native mobile requests do not send Origin.
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Required only when running npm run seed in server/
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-one-time-password